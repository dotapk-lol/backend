[Unit]
Description=DOTA DUEL isolated signaling and results API
After=network.target mysqld.service
[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/opt/dota-duel
ExecStart=/opt/dota-duel/bin/dueld
LoadCredential=mysql-dsn:/etc/dota-duel/mysql-dsn
Environment=DUEL_MYSQL_DSN_FILE=%d/mysql-dsn
Environment=DUEL_LISTEN=127.0.0.1:18082
# Add DUEL_ALLOWED_ORIGIN only when the frontend origin is approved.
EnvironmentFile=-/etc/dota-duel/public.env
Restart=on-failure
RestartSec=5s
MemoryMax=128M
CPUQuota=25%
TasksMax=32
LimitNOFILE=1024
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost
[Install]
WantedBy=multi-user.target
